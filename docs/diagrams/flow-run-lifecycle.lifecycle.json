  "cards": [
    {
      "dot": "cyan",
      "title": "主链",
      "items": [
        "initialize 先插元数据，run_started 落盘后才派发节点",
        "节点全部到达终态才 finalize，没有中间快照状态",
        "succeeded 输出走 singular_or_map 规则"
      ]
    },
    {
      "dot": "emerald",
      "title": "可恢复等待",
      "items": [
        "waiting 与 retrying 都不是终态，都回到 running",
        "human_task 等待只挂 oneshot，不消耗调度轮次",
        "退避计时器计入 inflight，否则终止判定提前触发"
      ]
    },
    {
      "dot": "rose",
      "title": "终态与分级",
      "items": [
        "failed 只在首个致命节点失败后由 fold 持久推导",
        "cancelled 由 cancel 信号触发，副作用歧义不裁决",
        "重启时 recover_unfinished 分流重放；平台故障只挂起"
      ]
    }
  ]
